{
  "name": "reviseliketeacher",
  "version": "1.0.0",
  "description": "NEET PG preparation platform with personalized revision planning",
  "main": "backend/server.js",
  "scripts": {
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "db:migrate": "psql -d reviseliketeacher -f backend/database/schema.sql",
    "db:seed": "psql -d reviseliketeacher -f backend/database/seed_data.sql",
    "db:reset": "psql -d reviseliketeacher -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "education",
    "neet-pg",
    "medical-exams",
    "revision-scheduler"
  ],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "backend",
    "frontend"
  ]
}

